# Database Configuration
POSTGRES_DB=car_prediction
POSTGRES_USER=bpr_user
POSTGRES_PASSWORD=change_this_strong_password_in_production

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-very-secret-key-change-this-in-production

# CORS Configuration (comma-separated origins for production)
# For development: ALLOWED_ORIGINS=*
# For production: ALLOWED_ORIGINS=https://your-site.netlify.app,https://api.yourdomain.com
ALLOWED_ORIGINS=*

# Cloudflare Tunnel Configuration (optional)
# Get your token: cloudflared tunnel token bpr-backend
# Uncomment to use Cloudflare Tunnel in Docker
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Prediction Queue
# Modes: sync (always inline), queue (always enqueue), hybrid (auto enqueue when busy)
PREDICTION_QUEUE_MODE=hybrid
PREDICTION_QUEUE_THRESHOLD=5
PREDICTION_QUEUE_PRIORITY_DEFAULT=100
PREDICTION_QUEUE_POLL_INTERVAL=1.5
PREDICTION_QUEUE_MAX_ATTEMPTS=3

# Optional: For Raspberry Pi deployment via SSH
# PI_HOST=192.168.1.100
# PI_USERNAME=pi
# PI_PORT=22
